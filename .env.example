# Google Sheets — service account (NEVER commit real values)
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Paste the private key exactly as-is from the JSON key file (with literal \n for newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...your key...\n-----END PRIVATE KEY-----\n"

# On-demand revalidation secret (generate with: openssl rand -base64 32)
REVALIDATE_SECRET=your_random_secret_here
